partial common {}
// <- keyword

caveat check(value string) {
//                         ^ punctuation.bracket
  {"key": value}
}
// <- punctuation.bracket

definition resource {
  ...common
//^ operator
//   ^ type

  relation viewer: user with somecaveat and expiration
//                                        ^ keyword
//                                            ^ keyword

  relation editor: user with expiration and somecaveat
//                                      ^ keyword

  permission view = self
//                  ^ keyword

  permission typed: user | group = viewer
//                  ^ type
//                         ^ type

  permission arrow = parent.any(member).all(editor)->viewer
